diff --git a/osfmk/arm/machine_routines_common.c b/osfmk/arm/machine_routines_common.c
index a6af1b9..794c09b 100644
--- a/osfmk/arm/machine_routines_common.c
+++ b/osfmk/arm/machine_routines_common.c
@@ -1283,6 +1283,15 @@ ml_set_max_cpus(unsigned int max_cpus __unused)
 unsigned int
 ml_wait_max_cpus(void)
 {
+#if defined(SWEET)
+	/*
+	 * sweet: MAX_CPUS_SET is only written by the secondary bring-up, which
+	 * runs after bsd_init(). Sleeping here (kperf_init_early) therefore
+	 * deadlocks the boot thread with no output. The topology already knows
+	 * the final CPU count, so return it without waiting.
+	 */
+	return machine_info.max_cpus;
+#else
 	assert(lockdown_done);
 	lck_mtx_lock(&max_cpus_lock);
 	while (max_cpus_initialized != MAX_CPUS_SET) {
@@ -1291,6 +1300,7 @@ ml_wait_max_cpus(void)
 	}
 	lck_mtx_unlock(&max_cpus_lock);
 	return machine_info.max_cpus;
+#endif /* SWEET */
 }
 
 void
